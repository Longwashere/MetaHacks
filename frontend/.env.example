# Supabase project (Project Settings → API). The anon / publishable key is safe in the browser,
# but here it's only used server-side for Google sign-in.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# The backend API (defaults to http://localhost:4000)
# BACKEND_URL=http://localhost:4000

# Canonical public origin in production (canonical tags, OAuth redirect, sitemap)
# PUBLIC_SITE_URL=https://rigforge.com
