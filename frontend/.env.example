# Supabase project (Project Settings → API). The anon / publishable key is safe in the browser,
# but here it's only used server-side for Google sign-in.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Local dev runs on the Workers runtime, which also loads the production vars in wrangler.jsonc,
# so set these to keep dev pointed at your machine. Production values live in wrangler.jsonc.
BACKEND_URL=http://localhost:4000
PUBLIC_SITE_URL=http://localhost:5173
