{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "upload:spine": "tsx --env-file-if-exists=.env src/scripts/upload-spine.ts"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "express": "^5.3.0",
    "sharp": "^0.35.5",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
