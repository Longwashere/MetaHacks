{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "upload:spine": "tsx --env-file-if-exists=.env src/scripts/upload-spine.ts",
    "create-judge": "tsx --env-file-if-exists=.env src/scripts/create-judge.ts",
    "set-admin": "tsx --env-file-if-exists=.env src/scripts/set-admin.ts",
    "pull:remixes": "tsx --env-file-if-exists=.env src/scripts/pull-remixes.ts",
    "backfill:fingerprints": "tsx --env-file-if-exists=.env src/scripts/backfill-fingerprints.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@esotericsoftware/spine-core": "^4.2.120",
    "@supabase/supabase-js": "^2.118.0",
    "aws4fetch": "^1.0.20",
    "delaunator": "^5.1.0",
    "express": "^5.3.0",
    "sharp": "^0.35.5",
    "stripe": "^23.0.1",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
