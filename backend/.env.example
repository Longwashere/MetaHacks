PORT=4000
# Meta Model API key from dev.meta.ai (MODEL_API_KEY also works)
META_API_KEY=

# Models (defaults shown)
# MUSE_MODEL=muse-spark-1.3
# IMAGE_MODEL=muse-image-1.0
# META_API_BASE_URL=https://api.meta.ai/v1

# Where base rig files (/spine/...) are served from: the frontend in dev
# ASSET_BASE_URL=http://localhost:5173
# This server's public origin; generated textures are served at $PUBLIC_URL/files/remixes/<job>/
# PUBLIC_URL=http://localhost:4000
# REMIX_OUTPUT_DIR=data/remixes

# AI timeouts in milliseconds (defaults: job 30 min, Muse 5 min, image model 20 min)
# REMIX_JOB_TIMEOUT_MS=1800000
# MUSE_TIMEOUT_MS=300000
# IMAGE_TIMEOUT_MS=1200000
