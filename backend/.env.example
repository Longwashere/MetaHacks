PORT=4000
# Meta Model API key from dev.meta.ai (MODEL_API_KEY also works)
META_API_KEY=

# Models (defaults shown)
# MUSE_MODEL=muse-spark-1.3
# IMAGE_MODEL=muse-image-1.0
# META_API_BASE_URL=https://api.meta.ai/v1

# Where base rig files (/spine/...) are served from: the frontend in dev, or R2_PUBLIC_URL once
# they're uploaded with `npm run upload:spine`
# ASSET_BASE_URL=http://localhost:5173
# This server's public origin; generated textures are served at $PUBLIC_URL/files/remixes/<job>/
# PUBLIC_URL=http://localhost:4000
# REMIX_OUTPUT_DIR=data/remixes

# AI timeouts in milliseconds (defaults: job 30 min, Muse 5 min, image model 20 min)
# REMIX_JOB_TIMEOUT_MS=1800000
# MUSE_TIMEOUT_MS=300000
# IMAGE_TIMEOUT_MS=1200000

# Cloudflare R2 for generated files. Leave any of these empty to store them under REMIX_OUTPUT_DIR instead.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=metahacks-remixes
# Public origin of the bucket (r2.dev subdomain or custom domain), no trailing slash
# R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Supabase project (Project Settings → API). The service-role / secret key bypasses RLS: backend only.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# The website's public origin, for Stripe's return URLs
# APP_URL=http://localhost:5173

# Stripe subscription (Pro plan). Billing returns 503 until all three are set.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...

# Remixes per calendar month (failed ones don't count)
# FREE_MONTHLY_REMIXES=3
# PRO_MONTHLY_REMIXES=100
